<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Calculator Display -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#1E1E1E"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:gravity="bottom|end"
        android:padding="16dp"
        android:text="0"
        android:singleLine="true"
        android:ellipsize="start"
        android:layout_marginBottom="16dp" />

    <!-- Button Pad using GridLayout (4 columns) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <!-- Row 1: Clear, Backspace, Division, Multiplication -->
        <Button
            android:id="@+id/btnClear"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="C"
            android:textSize="22sp"
            android:backgroundTint="#CF6679"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnBack"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="⌫"
            android:textSize="22sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnPercent"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="%"
            android:textSize="22sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnDivide"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="÷"
            android:textSize="24sp"
            android:backgroundTint="#03DAC6"
            android:textColor="#000000"
            android:layout_margin="4dp" />

        <!-- Row 2: 7, 8, 9, Minus -->
        <Button
            android:id="@+id/btn7"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="7"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn8"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="8"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn9"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="9"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnMultiply"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="×"
            android:textSize="24sp"
            android:backgroundTint="#03DAC6"
            android:textColor="#000000"
            android:layout_margin="4dp" />

        <!-- Row 3: 4, 5, 6, Plus -->
        <Button
            android:id="@+id/btn4"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="4"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn5"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="5"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn6"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="6"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnMinus"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="-"
            android:textSize="24sp"
            android:backgroundTint="#03DAC6"
            android:textColor="#000000"
            android:layout_margin="4dp" />

        <!-- Row 4: 1, 2, 3, Plus -->
        <Button
            android:id="@+id/btn1"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="1"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn2"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="2"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btn3"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="3"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnPlus"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="+"
            android:textSize="24sp"
            android:backgroundTint="#03DAC6"
            android:textColor="#000000"
            android:layout_margin="4dp" />

        <!-- Row 5: 0 (Span 2 columns), Decimal, Equals -->
        <Button
            android:id="@+id/btn0"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="2"
            android:layout_rowWeight="1"
            android:text="0"
            android:textSize="22sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnDot"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="."
            android:textSize="24sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnEquals"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="="
            android:textSize="24sp"
            android:backgroundTint="#BB86FC"
            android:textColor="#000000"
            android:layout_margin="4dp" />

    </GridLayout>

</LinearLayout>